{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  schedule: ["every weekend"],
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  packageRules: [
    {
      // Merging a bump to these auto-triggers a LIVE rolling cluster upgrade:
      // the tuppr TalosUpgrade/KubernetesUpgrade CRs
      // (kubernetes/apps/system-upgrade/tuppr/upgrades/{talos,kubernetes}.yaml)
      // are Flux-managed, so Flux applies the new version and tuppr immediately
      // drains+reboots each node. Require explicit approval so upgrades happen
      // on our terms: Renovate still surfaces new versions under "Pending
      // Approval" on the dashboard, but opens no PR until the box is ticked.
      // Also covers the (inert) talos/talenv.yaml, keeping all three in step.
      //
      // ORDER MATTERS: Talos must lead Kubernetes. Talos 1.13 caps at k8s 1.36,
      // so approving a kubelet bump without the matching Talos bump makes the
      // KubernetesUpgrade job fail permanently (happened 2026-09-01: k8s v1.37.0
      // approved while Talos sat at v1.13.9). Approve Talos first, let it roll
      // all 3 nodes, then approve kubelet.
      //
      // `siderolabs/talos` (github-releases) replaced
      // `ghcr.io/siderolabs/installer` (docker) as the Talos datasource: that
      // image stopped publishing after 1.13.x, so Renovate silently stopped
      // seeing Talos releases while kubelet kept advancing. The old name is kept
      // in the match list so any lingering reference stays gated too.
      description: "Require manual approval for Talos & Kubernetes version bumps",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/kubelet",
      ],
      dependencyDashboardApproval: true,
    },
    {
      // v4.0.1 was merged 2026-08-23 and broke the app: the Helm upgrade timed
      // out, the rollback to v3.4.1 also failed, and the release sat wedged
      // (revisions 14-17 failed) with the pod crashlooping - it authenticates
      // to the controller and logs "Prometheus is enabled" but never opens its
      // listener, so the probe kills it. Pinned back to v3.4.1 in
      // kubernetes/apps/observability/unpoller/app/helmrelease.yaml.
      // Approval-gated rather than disabled outright so v3.x patch/minor fixes
      // still flow automatically; v4 stays on the dashboard under "Pending
      // Approval" until someone confirms it actually serves metrics here.
      description: "Require manual approval for unpoller major bumps",
      matchPackageNames: ["ghcr.io/unpoller/unpoller"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Jellyfin 12 (there is no 11) rewrites its database on FIRST BOOT and
      // there is no downgrade path - a backup is the only way back. Rolling
      // back the image after it has booted does not undo the schema change.
      // Unlike every other app here, an unattended weekend merge of this one is
      // not recoverable by reverting a commit, so it must never auto-merge.
      // Pre-flight before approving: resolve case-duplicate usernames (v12 makes
      // them case-insensitive and migration FAILS on a collision), remove the
      // versioned plugin directory (10.x-targeted plugins can boot-loop v12),
      // take a fresh snapshot, and bump BOTH tags in the HelmRelease - the app
      // container and the enable-metrics init container.
      description: "Require manual approval for Jellyfin major bumps (v12 = irreversible DB rewrite)",
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // The home-operations *arr images track each app's develop (beta) branch,
      // and the four-part tags carry no -beta marker, so Renovate cannot tell a
      // beta from a stable build - all three have run prerelease builds most of
      // the time. Majors are where that bites: they spend weeks as upstream
      // PRERELEASES (every Sonarr v5.0.0.x build was prerelease=true; v5 landed
      // this way, unnoticed, in PR #153), and a major migrates the database on
      // first boot so the previous major cannot run against it. Reverting the
      // image is not a rollback; only restoring the VolSync/Kopia snapshot is.
      // Pre-flight before approving: check `prerelease` on the release at
      // github.com/{Sonarr/Sonarr,Radarr/Radarr,Prowlarr/Prowlarr}/releases,
      // and confirm a recent Kopia snapshot of <app>@media:/data exists (they
      // back up hourly).
      description: "Require manual approval for Sonarr/Radarr/Prowlarr major bumps (prerelease betas, irreversible DB migration)",
      matchPackageNames: [
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/prowlarr",
      ],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Private trackers only accept whitelisted client versions, so ANY
      // qBittorrent bump - patch, minor or major - can silently stop seed
      // credit. 5.2.3 -> 5.3.0 (PR #137) did exactly that: Anthelion answered
      // every announce with "Your client is not on the whitelist" while the
      // torrents kept seeding, so nothing looked broken locally.
      // Pre-flight before approving: confirm the new version is on Anthelion's
      // client whitelist.
      description: "Require manual approval for every qBittorrent update (private-tracker client whitelist)",
      matchPackageNames: ["ghcr.io/home-operations/qbittorrent"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
  customManagers: [
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/\\.yaml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
